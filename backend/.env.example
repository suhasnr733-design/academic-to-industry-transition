# ==========================================
# Application & Environment Configuration
# ==========================================
FLASK_APP=run.py
FLASK_ENV=development
FLASK_CONFIG=app.config.DevelopmentConfig
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key-in-production
DEBUG=True
PORT=5000

# ==========================================
# Database Configuration
# ==========================================
# SQLite for local development; use PostgreSQL connection string in production
DATABASE_URL=sqlite:///instance/site.db

# ==========================================
# Authentication & JWT Configuration
# ==========================================
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-jwt-secret-key-in-production

# ==========================================
# Frontend & CORS Configuration
# ==========================================
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ==========================================
# Initial Admin Seeding (Optional)
# ==========================================
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me-admin-secure-password

# ==========================================
# Rate Limiting Configuration
# ==========================================
# Use memory:// for local dev, or redis://localhost:6379/0 in production
RATELIMIT_STORAGE_URI=memory://

# ==========================================
# Mail / Brevo (Sendinblue) SMTP Configuration
# ==========================================
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-brevo-account-email@example.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_DEFAULT_SENDER=your-brevo-account-email@example.com

# ==========================================
# Google OAuth Configuration
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# ==========================================
# LinkedIn OAuth Configuration
# ==========================================
LINKEDIN_CLIENT_ID=your_linkedin_client_id_placeholder
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_placeholder
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/v1/auth/linkedin/callback

# ==========================================
# Real-Time Job Providers & Aggregators
# ==========================================
# Option A: Remotive & Arbeitnow (Free / Public APIs)
REMOTIVE_API_BASE_URL=https://remotive.com/api/remote-jobs
ARBEITNOW_API_BASE_URL=https://www.arbeitnow.com/api/job-board-api

# Option B: RapidAPI (JSearch) / Adzuna
RAPIDAPI_KEY=your_rapidapi_key_placeholder
ADZUNA_APP_ID=your_adzuna_app_id_placeholder
ADZUNA_APP_KEY=your_adzuna_app_key_placeholder

# Job Sync Settings
DEFAULT_JOB_LOCATION=India
JOB_SYNC_INTERVAL_HOURS=24

# ==========================================
# ML & AI LLM Service Configuration
# ==========================================
ML_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
