# Environment Configuration Example
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key-in-production
DATABASE_URL=sqlite:///instance/site.db
DEBUG=True
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-jwt-secret-key-in-production

# Frontend URL (defaults to http://localhost:5173 in development)
FRONTEND_URL=http://localhost:5173

# Brevo (Sendinblue) SMTP Configuration
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-brevo-account-email@example.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_DEFAULT_SENDER=your-brevo-account-email@example.com

# Google OAuth Configuration (Dummy Placeholders)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
GOOGLE_REDIRECT_URI=https://academic-to-industry-transition.onrender.com/api/v1/auth/google/callback

# LinkedIn OAuth Configuration (Dummy Placeholders)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_placeholder
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_placeholder
LINKEDIN_REDIRECT_URI=https://academic-to-industry-transition.onrender.com/api/v1/auth/linkedin/callback


